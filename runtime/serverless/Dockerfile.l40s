FROM pytorch/pytorch:2.3.1-cuda12.1-cudnn8-runtime

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/app:/app/third_party/Matcha-TTS \
    MODEL_DIR=/data/models/somali

RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential \
      libsndfile1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY runtime/serverless/requirements.inference.txt /tmp/requirements.inference.txt
# openai-whisper 20231117 imports pkg_resources while preparing its wheel.
# Setuptools 81 removed that compatibility module, so keep the final runtime
# on the last compatible setuptools release and avoid an isolated build env.
RUN pip install --no-cache-dir 'setuptools<81' wheel \
    && pip install --no-cache-dir --no-build-isolation -r /tmp/requirements.inference.txt

# Kept separate so adding CosyVoice-only runtime dependencies does not
# invalidate the large, shared inference dependency layer on future updates.
RUN pip install --no-cache-dir \
      conformer==0.3.2 \
      diffusers==0.29.0 \
      hydra-core==1.3.2 \
      lightning==2.2.4 \
      matplotlib==3.7.5 \
      rich==13.7.1 \
      gdown==5.1.0 \
      wget==3.2

COPY cosyvoice /app/cosyvoice
COPY third_party/Matcha-TTS /app/third_party/Matcha-TTS
COPY asset/somali_pace_prompts /app/asset/somali_pace_prompts
COPY runtime/serverless /app/runtime/serverless

RUN chmod +x /app/runtime/serverless/entrypoint.sh
EXPOSE 8000
ENTRYPOINT ["/app/runtime/serverless/entrypoint.sh"]
