# vLLM bundles a matched PyTorch/CUDA runtime. Starting from this image avoids
# compiling vLLM against the incompatible torch 2.3 runtime used by the
# baseline container.
FROM vllm/vllm-openai:v0.11.0

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/app:/app/third_party/Matcha-TTS \
    MODEL_DIR=/runpod-volume/models/somali \
    COSYVOICE_BACKEND=vllm

RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential \
      libsndfile1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY runtime/serverless/requirements.vllm.txt /tmp/requirements.vllm.txt
# vLLM v0.11.0 supplies torch 2.8. Whisper's legacy build imports
# pkg_resources, so retain the last compatible setuptools release. Install
# matching companions without replacing vLLM's CUDA/Triton runtime.
RUN pip install --no-cache-dir 'setuptools<81' wheel \
    && pip install --no-cache-dir --no-build-isolation --no-deps \
      torchaudio==2.8.0 \
      openai-whisper==20231117 \
    && pip install --no-cache-dir --no-build-isolation -r /tmp/requirements.vllm.txt

RUN pip install --no-cache-dir \
      conformer==0.3.2 \
      diffusers==0.29.0 \
      hydra-core==1.3.2 \
      lightning==2.2.4 \
      matplotlib==3.7.5 \
      rich==13.7.1 \
      gdown==5.1.0 \
      wget==3.2

COPY cosyvoice /app/cosyvoice
COPY third_party/Matcha-TTS /app/third_party/Matcha-TTS
COPY asset/somali_pace_prompts /app/asset/somali_pace_prompts
COPY runtime/serverless /app/runtime/serverless

EXPOSE 8000
# Queue workers launch the Docker CMD.  Do not use an ENTRYPOINT here: the
# Runpod worker runtime must execute this exact Python process.
CMD ["python", "-u", "/app/runtime/serverless/runpod_queue_entry.py"]
